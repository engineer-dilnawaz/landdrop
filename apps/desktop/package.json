{
  "name": "@landrop/desktop",
  "version": "0.2.4",
  "private": true,
  "description": "LANDrop for Mac and Windows: runs the LANDrop host from the menu bar or system tray.",
  "author": "LANDrop",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --external:bufferutil --external:utf-8-validate --outdir=dist --out-extension:.js=.cjs",
    "start": "electron .",
    "dist": "electron-builder --mac",
    "typecheck": "tsc -p .",
    "icons": "electron scripts/make-icons.cjs",
    "dist:mac-intel": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@landrop/lan-server": "*",
    "@landrop/protocol": "*",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "app.landrop.desktop",
    "productName": "LANDrop",
    "files": [
      "dist/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "LANDrop uses the microphone only while you record a voice message.",
        "NSLocalNetworkUsageDescription": "LANDrop shares files with the phones and computers on your Wi-Fi, and recognises which Wi-Fi you're on so each one keeps its own chat history."
      },
      "icon": "assets/icon.png",
      "hardenedRuntime": false
    },
    "artifactName": "LANDrop-mac-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "LANDrop-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
