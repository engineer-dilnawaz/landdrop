{
  "name": "@landrop/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "LANDrop for Mac: runs the LANDrop host from the menu bar.",
  "author": "LANDrop",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --external:bufferutil --external:utf-8-validate --outfile=dist/main.cjs",
    "start": "electron .",
    "dist": "electron-builder --mac",
    "typecheck": "tsc -p .",
    "icons": "electron scripts/make-icons.cjs"
  },
  "devDependencies": {
    "@landrop/lan-server": "*",
    "@landrop/protocol": "*",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "app.landrop.desktop",
    "productName": "LANDrop",
    "files": [
      "dist/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "assets/icon.png",
      "hardenedRuntime": false
    },
    "artifactName": "LANDrop-mac-${arch}.${ext}"
  }
}
