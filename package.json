{
  "name": "landrop",
  "private": true,
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dist:mac": "turbo run dist --filter=@landrop/desktop",
    "dist:mac-intel": "turbo run dist:mac-intel --filter=@landrop/desktop",
    "dist:win": "turbo run dist:win --filter=@landrop/desktop"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
