{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "@landrop/lan-server#start": {
      "dependsOn": [
        "@landrop/web#build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "@landrop/desktop#dist": {
      "dependsOn": [
        "@landrop/web#build",
        "build"
      ],
      "cache": false
    },
    "@landrop/desktop#dist:mac-intel": {
      "dependsOn": [
        "@landrop/web#build",
        "build"
      ],
      "cache": false
    },
    "@landrop/desktop#dist:win": {
      "dependsOn": [
        "@landrop/web#build",
        "build"
      ],
      "cache": false
    }
  }
}
